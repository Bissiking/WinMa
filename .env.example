# Luma OS — configuration locale sans secrets réels
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000

# Utilisez une valeur aléatoire d'au moins 32 caractères hors développement.
SESSION_SECRET=

# Catalogue public Harmonix/Sonora. Aucun compte Harmonix n'est requis.
LUMA_HARMONIX_BASE_URL=https://mhemery.fr
LUMA_HARMONIX_TIMEOUT_MS=10000

# Administration Sonora v5. Luma OS transmet le token Kyros de la session utilisateur.
LUMA_SONORA_STUDIO_BASE_URL=http://localhost:6002
LUMA_SONORA_STUDIO_TIMEOUT_MS=15000

# Application Luma OS distincte à créer dans l'administration Kyros.
LUMA_KYROS_BASE_URL=https://kyros-orbis.mhemery.fr
LUMA_KYROS_TOKEN_URL=https://kyros-orbis.mhemery.fr/token
LUMA_KYROS_REVOKE_URL=https://kyros-orbis.mhemery.fr/revoke
LUMA_KYROS_CLIENT_ID=
LUMA_KYROS_CLIENT_SECRET=
LUMA_KYROS_JWT_SECRET=
LUMA_KYROS_ISSUER=kyros
LUMA_KYROS_AUDIENCE=kyros-modules
LUMA_KYROS_RESOURCE_AUDIENCE=
LUMA_KYROS_REQUESTED_SCOPES=profile email
LUMA_KYROS_REQUIRED_SCOPES=profile email
LUMA_KYROS_CALLBACK_URL=http://localhost:3000/auth/callback
LUMA_KYROS_TIMEOUT_MS=5000
