# Luma OS — configuration locale sans secrets réels
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000

# Utilisez une valeur aléatoire d'au moins 32 caractères hors développement.
SESSION_SECRET=

# --- Base de données ---------------------------------------------------------
# DB_PROVIDER=sqlite|postgresql
# sqlite       : développement uniquement (fichier data/luma.sqlite, conservé).
# postgresql   : production (obligatoire si NODE_ENV=production). Si la
#                connexion échoue, le serveur s'arrête : jamais de repli SQLite.
DB_PROVIDER=sqlite
# Chemin du fichier SQLite (relatif au projet ou absolu) — optionnel.
#SQLITE_PATH=data/luma.sqlite
# Connexion PostgreSQL : soit une URL complète, soit les variables libpq.
DATABASE_URL=
#PGHOST=127.0.0.1
#PGPORT=5432
#PGUSER=luma
#PGPASSWORD=
#PGDATABASE=luma
# Taille du pool de connexions (PostgreSQL accepte les requêtes concurrentes).
#DB_POOL_MAX=10
#DB_CONNECT_TIMEOUT_MS=5000
#DB_IDLE_TIMEOUT_MS=30000
# Répertoire des migrations SQL versionnées — optionnel.
#DB_MIGRATIONS_DIR=migrations

# Catalogue public Harmonix/Sonora. Aucun compte Harmonix n'est requis.
LUMA_HARMONIX_BASE_URL=https://mhemery.fr
LUMA_HARMONIX_TIMEOUT_MS=10000

# Administration Sonora v5. Luma OS transmet le token Kyros de la session utilisateur.
LUMA_SONORA_STUDIO_BASE_URL=http://localhost:6002
LUMA_SONORA_STUDIO_TIMEOUT_MS=15000

# BrainDump natif. Luma relaie le jeton Kyros de la session utilisateur.
LUMA_BRAINDUMP_BASE_URL=https://note-orbis.mhemery.fr
LUMA_BRAINDUMP_TIMEOUT_MS=10000

# Application Luma OS distincte à créer dans l'administration Kyros.
# Les variables acceptent les deux formats : LUMA_KYROS_* (Luma OS) et KYROS_* (standard Kyros).
LUMA_KYROS_BASE_URL=https://kyros-orbis.mhemery.fr
LUMA_KYROS_TOKEN_URL=https://kyros-orbis.mhemery.fr/token
LUMA_KYROS_REVOKE_URL=https://kyros-orbis.mhemery.fr/revoke
LUMA_KYROS_CLIENT_ID=
LUMA_KYROS_CLIENT_SECRET=
LUMA_KYROS_JWT_SECRET=
LUMA_KYROS_ISSUER=kyros
LUMA_KYROS_AUDIENCE=kyros-modules
LUMA_KYROS_RESOURCE_AUDIENCE=
LUMA_KYROS_REQUESTED_SCOPES=profile email braindump:access
LUMA_KYROS_REQUIRED_SCOPES=profile email
LUMA_KYROS_CALLBACK_URL=http://localhost:3000/auth/callback
LUMA_KYROS_TIMEOUT_MS=5000

# SSO handshake metadata (required by Kyros v4.4.0+)
LUMA_KYROS_SSO_VERSION=v3
LUMA_KYROS_EDITION=standard
LUMA_KYROS_APPLICATION_SCOPE=standard
